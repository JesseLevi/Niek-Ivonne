---
import '../styles/global.css';

interface Props {
  title: string;
  lang?: string;
}

const { title, lang = 'en' } = Astro.props;

// Alleen de fonts die de splash nodig heeft: namen (serif cursief) en de mono-regel.
const preloadFonts = ['/fonts/instrument-serif-italic.woff2', '/fonts/ibm-plex-mono-regular.woff2'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>
      // Thema vóór de eerste paint: eigen keuze (rolluik) of anders de systeeminstelling.
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('ni-theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
