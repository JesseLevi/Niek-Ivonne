---
import Base from '../../layouts/Base.astro';
import Backdrop from '../../components/Backdrop.astro';
import Chrome from '../../components/Chrome.astro';
import GuestData from '../../components/GuestData.astro';
import Splash from '../../components/scenes/Splash.astro';
import TwoPlaces from '../../components/scenes/TwoPlaces.astro';
import Lima from '../../components/scenes/Lima.astro';
import Netherlands from '../../components/scenes/Netherlands.astro';
import Barcelona from '../../components/scenes/Barcelona.astro';
import Messages from '../../components/scenes/Messages.astro';
import Visit from '../../components/scenes/Visit.astro';
import BackAndForth from '../../components/scenes/BackAndForth.astro';
import Amsterdam from '../../components/scenes/Amsterdam.astro';
import ToLima from '../../components/scenes/ToLima.astro';
import Andes from '../../components/scenes/Andes.astro';
import Girona from '../../components/scenes/Girona.astro';
import Info from '../../components/scenes/Info.astro';
import Rsvp from '../../components/scenes/Rsvp.astro';
import Credits from '../../components/scenes/Credits.astro';
import { site } from '../../lib/content';
import type { Locale } from '../../lib/i18n';
import { localeStaticPaths } from '../../lib/routes';

export const getStaticPaths = localeStaticPaths;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<Base title={site.og.title[lang]} description={site.og.description[lang]} lang={lang} localizedFrom="/">
  <GuestData lang={lang} slot="head" />
  <Backdrop />
  <Chrome lang={lang} />
  <main>
    <Splash lang={lang} />
    <TwoPlaces lang={lang} />
    <Lima lang={lang} />
    <Netherlands lang={lang} />
    <Barcelona lang={lang} />
    <Messages lang={lang} />
    <Visit lang={lang} />
    <BackAndForth lang={lang} />
    <Amsterdam lang={lang} />
    <ToLima lang={lang} />
    <Andes lang={lang} />
    <Girona lang={lang} />
    <Info lang={lang} />
    <Rsvp lang={lang} />
    <Credits lang={lang} />
  </main>
</Base>

<script>
  import { startStage } from '../../scripts/stage';
  import { initChrome } from '../../scripts/chrome';

  const stage = startStage();
  initChrome(stage, stage.restored);
</script>
