---
// Plat vliegtuigje van bovenaf, monoline in de accentkleur. Neus wijst naar rechts.
interface Props {
  class?: string;
  /** Extra attributen, bijv. data-plane. */
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<svg class:list={['plane', className]} viewBox="0 0 64 64" aria-hidden="true" {...rest}>
  <path
    d="M60 32c0-2.2-1.8-3.4-4-3.4H40.5L26.6 6.8C26 5.9 25 5.4 24 5.4h-3.2l7.6 23.2H14.2L9.4 21.8C9 21.2 8.3 20.8 7.6 20.8H4.4l3.4 11.2-3.4 11.2h3.2c.7 0 1.4-.4 1.8-1l4.8-6.8h14.2l-7.6 23.2H24c1 0 2-.5 2.6-1.4l13.9-21.8H56c2.2 0 4-1.2 4-3.4Z"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"></path>
</svg>

<style>
  .plane {
    display: block;
    color: var(--color-accent);
    overflow: visible;
  }
</style>
