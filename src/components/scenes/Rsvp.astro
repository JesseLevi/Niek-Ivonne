---
// Scène 13: RSVP als boarding pass die je invult. Versturen = de kaart wordt afgestempeld.
// Verstuurd naar het formulier in site.yml (rsvp.form_url, Formspree-compatibel: POST met JSON).
import { site, ui } from '../../lib/content';
import { fill, formatDate, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui.rsvp;
const open = site.rsvp.form_url !== '';
---

<section class="rsvp" id="rsvp" data-scene="rsvp" data-palette="info" data-module="rsvp" data-pin="0" aria-labelledby="rsvp-heading">
  <div class="intro" data-fade>
    <h2 class="text-serif" id="rsvp-heading">{t.heading[lang]}</h2>
    <p>{fill(t.intro[lang], { deadline: formatDate(site.rsvp.deadline, lang) })}</p>
  </div>

  <form
    class="card"
    data-fade
    data-rsvp
    action={open ? site.rsvp.form_url : undefined}
    method="post"
    data-messages={JSON.stringify({ sending: t.sending[lang], error: t.error[lang], offline: t.queued[lang], submit: t.submit[lang] })}
  >
    <div class="main">
      <p class="route text-mono">
        <span>{site.couple.first.slice(0, 1)}{site.couple.second.slice(0, 1)}</span>
        <span aria-hidden="true">→</span>
        <span>GRO</span>
      </p>

      <label class="field wide">
        <span class="text-mono">{t.name[lang]}</span>
        <input name="name" type="text" autocomplete="name" required data-guest-name />
      </label>

      <fieldset class="field wide">
        <legend class="text-mono">{t.attending[lang]}</legend>
        <label class="choice"><input type="radio" name="attending" value="yes" required checked /> {t.attending_yes[lang]}</label>
        <label class="choice"><input type="radio" name="attending" value="no" /> {t.attending_no[lang]}</label>
      </fieldset>

      <label class="field">
        <span class="text-mono">{t.party_size[lang]}</span>
        <input name="party_size" type="number" min="1" max="20" value="1" inputmode="numeric" required data-guest-party />
      </label>

      <label class="field">
        <span class="text-mono">{t.diet[lang]}</span>
        <input name="diet" type="text" />
      </label>

      <label class="field wide">
        <span class="text-mono">{t.message[lang]}</span>
        <textarea name="message" rows="2"></textarea>
      </label>

      <input type="hidden" name="language" value={lang} />
      <input type="hidden" name="guest" value="" data-guest-slug />
    </div>

    <div class="stub">
      <button class="submit text-mono" type="submit" disabled={!open}>{t.submit[lang]}</button>
      {!open && <p class="note">{t.closed[lang]}</p>}
      <p class="status" role="status" aria-live="polite" data-status></p>
    </div>

    <p class="stamp" aria-hidden="true" data-stamp>{t.confirmed[lang]}</p>
  </form>
</section>

<style>
  .rsvp {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--gutter);
  }

  [data-fade] {
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 800ms var(--ease-out),
      transform 800ms var(--ease-out);
  }

  [data-fade].is-visible {
    opacity: 1;
    transform: none;
  }

  .intro {
    display: grid;
    gap: var(--space-3);
    text-align: center;
    max-width: var(--measure);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .card {
    position: relative;
    display: grid;
    width: min(100%, 34rem);
    border-radius: 0.75rem;
    background: var(--card);
    color: var(--card-ink);
    filter: drop-shadow(0 10px 24px var(--shadow));
  }

  .main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .route {
    grid-column: 1 / -1;
    display: flex;
    gap: var(--space-3);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .route span:nth-child(2) {
    color: var(--card-accent);
  }

  .field {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .wide {
    grid-column: 1 / -1;
  }

  .field > span,
  legend {
    font-size: 0.6rem;
    opacity: 0.6;
    padding: 0;
  }

  input[type='text'],
  input[type='number'],
  textarea {
    width: 100%;
    padding: var(--space-2) 0;
    border: 0;
    border-bottom: 1px solid color-mix(in oklch, var(--card-ink) 25%, transparent);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    border-radius: 0;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-bottom-color: var(--card-accent);
  }

  .choice {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-1) 0;
  }

  .choice input {
    accent-color: var(--card-accent);
  }

  .stub {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    padding: var(--space-4) var(--space-5) var(--space-5);
    border-top: 2px dashed color-mix(in oklch, var(--card-ink) 20%, transparent);
  }

  .submit {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-radius: 999px;
    background: var(--card-accent);
    color: var(--card);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .note,
  .status {
    font-size: var(--text-sm);
    text-align: center;
  }

  .status:empty {
    display: none;
  }

  .stamp {
    position: absolute;
    right: 8%;
    top: 18%;
    padding: 0.3em 0.6em;
    border: 3px solid var(--stamp);
    border-radius: 0.4em;
    color: var(--stamp);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    rotate: -14deg;
    opacity: 0;
    scale: 2.4;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .card.is-confirmed .stamp {
    opacity: 0.9;
    scale: 1;
    transition:
      scale 380ms cubic-bezier(0.3, 1.6, 0.5, 1),
      opacity 200ms linear;
  }

  .card.is-confirmed :is(input, textarea, button) {
    pointer-events: none;
  }
</style>
