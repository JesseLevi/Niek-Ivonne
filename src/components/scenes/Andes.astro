---
// Scène 10: de Andes, het aanzoek. De climax: het traagst, alle UI weg. Bergen rijzen laag voor
// laag op, het vliegtuigraam is even het kader, dan het ringdoosje dat opengaat en "Sí.".
// De flight plan-lijn maakt een lus om de ring.
import SceneShell from '../SceneShell.astro';
import SceneMeta from '../SceneMeta.astro';
import SceneLines from '../SceneLines.astro';
import Illustration from '../Illustration.astro';
import Mountains from '../Mountains.astro';
import { getImage, sceneById } from '../../lib/content';
import { RAIL } from '../../lib/flight-plan';
import type { Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const scene = sceneById('andes');
const frame = getImage('01-raam');
const ring = (ax: number, ay: number) => ({ at: '[data-ring]', ax, ay });
---

<SceneShell
  id="andes"
  pin={380}
  hideUi
  labelledby="lines-andes"
  route={[
    {
      points: [[RAIL.single, 0], [RAIL.single, 5], [92, 22], ring(1.25, 0.2), ring(0.5, -0.12), ring(-0.22, 0.45), ring(0.5, 1.08), ring(1.2, 0.55), ring(0.85, -0.02), [93, 30], [93, 80], [RAIL.single, 95], [RAIL.single, 100]],
      draw: [0.1, 1],
    },
  ]}
>
  <div class="mountains-layer" data-mountains><Mountains /></div>
  <img class="window-frame" src={frame.src} alt="" width={frame.width} height={frame.height} loading="lazy" decoding="async" data-window-frame />
  <div class="stack">
    <SceneMeta label={scene.label} />
    <SceneLines lines={scene.lines} lang={lang} id="lines-andes" class="andes-lines" />
    <div class="fit">
    <div class="ring fit-item" data-ring style="--ratio: 487 / 740; --fit-max: 11rem">
      <Illustration id="12-ringdoosje-dicht" lang={lang} class="box box-closed" />
      {scene.image && <Illustration id={scene.image} lang={lang} class="box box-open" />}
    </div>
    </div>
  </div>
</SceneShell>

<style>
  /* Ringdoosje (en tekst) vóór de lijn: de lus loopt achter het doosje langs. */
  .stack {
    z-index: 3 !important;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    align-items: start;
    justify-items: center;
    gap: var(--space-4);
    height: 100%;
    padding-bottom: 20svh;
  }

  .mountains-layer {
    position: absolute !important;
    inset: 0;
    z-index: 0 !important;
  }

  .window-frame {
    position: absolute !important;
    left: 50%;
    top: 50%;
    width: 100vw;
    height: auto;
    translate: -50% -50%;
    scale: 2.4;
    z-index: 2 !important;
    pointer-events: none;
    filter: none;
  }

  .ring :global(.box) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stack :global(.andes-lines .line:last-child) {
    font-size: clamp(3rem, min(18vw, 13svh), 8rem);
    line-height: 1;
    color: var(--color-accent);
  }
</style>
