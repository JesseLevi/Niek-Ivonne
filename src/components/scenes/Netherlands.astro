---
// Scène 3: Nederland. Polder, en twee identieke figuurtjes: hij en zijn tweelingbroer.
// Verrassing: tik de verkeerde aan.
import SceneShell from '../SceneShell.astro';
import SceneMeta from '../SceneMeta.astro';
import SceneLines from '../SceneLines.astro';
import Illustration from '../Illustration.astro';
import Twin from '../Twin.astro';
import { sceneById, ui } from '../../lib/content';
import { railsRoute } from '../../lib/flight-plan';
import type { Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const scene = sceneById('netherlands');
---

<SceneShell id="netherlands" pin={200} labelledby="lines-netherlands" route={railsRoute()}>
  <div class="stack">
    <SceneMeta label={scene.label} />
    <div class="visual">
      {scene.image && <Illustration id={scene.image} lang={lang} class="image" />}
      <div class="twins">
        <Twin side="left" label={ui.twin[lang]} />
        <Twin side="right" label={ui.twin[lang]} />
        <svg class="arrow" viewBox="0 0 80 60" aria-hidden="true" data-arrow>
          <path d="M74 6C58 8 30 20 14 46" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          <path d="M9 34l5 12 12-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {
          scene.surprise && (
            <p class="nope text-mono" data-surprise role="status" hidden>
              {scene.surprise[lang]}
            </p>
          )
        }
      </div>
    </div>
    <SceneLines lines={scene.lines} lang={lang} id="lines-netherlands" />
  </div>
</SceneShell>

<style>
  .stack {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-items: center;
    gap: var(--space-4);
    height: 100%;
  }

  .visual {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    width: min(100%, 36rem);
  }

  .visual :global(.image) {
    width: 100%;
  }

  .twins {
    position: relative;
    display: flex;
    gap: var(--space-5);
    margin-top: calc(var(--space-6) * -1);
  }

  .arrow {
    position: absolute;
    right: -3.2rem;
    top: -2.4rem;
    width: 3.6rem;
    color: var(--color-accent);
  }

  .nope {
    position: absolute;
    left: 50%;
    bottom: calc(100% + var(--space-3));
    translate: -50% 0;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    white-space: nowrap;
  }
</style>
