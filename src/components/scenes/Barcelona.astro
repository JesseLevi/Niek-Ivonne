---
// Scène 4: Barcelona, huisgenoten. De twee lijnen raken elkaar op één stip.
// Gevel, dan inzoomen op het messing deurbelpaneel met hun twee namen.
import SceneShell from '../SceneShell.astro';
import SceneMeta from '../SceneMeta.astro';
import SceneLines from '../SceneLines.astro';
import Illustration from '../Illustration.astro';
import { previousPlace, sceneById, site, ui } from '../../lib/content';
import { RAIL } from '../../lib/flight-plan';
import type { Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const scene = sceneById('barcelona');
const meet: [number, number] = [RAIL.single, 3.5];
---

<SceneShell
  id="barcelona"
  pin={300}
  labelledby="lines-barcelona"
  route={[
    { points: [[RAIL.lima, 0], [RAIL.lima, 1.5], [30, 3], meet], draw: [0, 0.3] },
    { points: [[RAIL.netherlands, 0], [RAIL.netherlands, 1.5], [70, 3], meet], end: 'dot', draw: [0, 0.3] },
    { points: [meet, [20, 9], [6, 24], [6, 78], [RAIL.single, 95], [RAIL.single, 100]], draw: [0.3, 1] },
  ]}
>
  <div class="stack">
    <SceneMeta label={scene.label} place={scene.place} from={previousPlace('barcelona')} />
    <div class="visual">
      {scene.image && <Illustration id={scene.image} lang={lang} class="facade" />}
      <div class="intercom" data-intercom>
        <Illustration id="08-deurbel" lang={lang} class="intercom-image" />
        <span class="plate plate-1 text-mono" data-plate>{site.couple.second}</span>
        <span class="plate plate-2 text-mono" data-plate>{site.couple.first}</span>
        <button class="bell bell-1" type="button" aria-label={`${ui.doorbell[lang]}: ${site.couple.second}`} data-bell></button>
        <button class="bell bell-2" type="button" aria-label={`${ui.doorbell[lang]}: ${site.couple.first}`} data-bell></button>
        {
          scene.surprise && (
            <p class="buzz text-mono" data-surprise role="status" hidden>
              {scene.surprise[lang]}
            </p>
          )
        }
      </div>
    </div>
    <SceneLines lines={scene.lines} lang={lang} id="lines-barcelona" class="compact" />
  </div>
</SceneShell>

<style>
  .stack {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-items: center;
    justify-items: center;
    gap: var(--space-4);
    height: 100%;
  }

  .visual {
    position: relative;
    height: 100%;
    max-height: 52svh;
    aspect-ratio: 751 / 1112;
  }

  .visual :global(.facade) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .intercom {
    position: absolute;
    inset: 4% 8%;
    container-type: inline-size;
  }

  .intercom :global(.intercom-image) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Naambordjes en knoppen op de plek van het beeld (08-deurbel: 685 × 971). */
  .plate {
    position: absolute;
    left: 15.5%;
    width: 51%;
    height: 9.2%;
    display: grid;
    place-items: center;
    color: var(--card-ink);
    font-size: clamp(0.55rem, 7cqi, 1rem);
    letter-spacing: 0.12em;
  }

  .plate-1 {
    top: 53.2%;
  }

  .plate-2 {
    top: 70%;
  }

  .bell {
    position: absolute;
    left: 73%;
    width: 15%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }

  .bell-1 {
    top: 53%;
  }

  .bell-2 {
    top: 69.5%;
  }

  .buzz {
    position: absolute;
    left: 50%;
    top: 30%;
    translate: -50% 0;
    width: max-content;
    max-width: 80vw;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    text-transform: none;
    letter-spacing: 0.02em;
    white-space: normal;
    text-align: center;
  }

  .stack :global(.compact .text-serif) {
    font-size: var(--text-xl);
  }
</style>
