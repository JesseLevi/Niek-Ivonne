---
// Stuk flight plan-lijn van één scène. Het script tekent de lijn met de scroll mee.
import type { RouteLine } from '../lib/flight-plan';

interface Props {
  route: RouteLine[];
  /** Splash: tekent zichzelf bij het laden in plaats van met de scroll. */
  intro?: boolean;
}

const { route, intro = false } = Astro.props;
---

<svg class="flight-plan" data-flight-plan data-route={JSON.stringify(route)} data-intro={intro ? '' : undefined} aria-hidden="true"></svg>

<style>
  .flight-plan {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    /* Vóór de beelden (kaart, gevel), net als de pins. */
    z-index: 2;
  }

  .flight-plan :global(.flight-plan-reveal) {
    fill: none;
    stroke: white;
    stroke-width: 12;
    stroke-linecap: round;
  }

  .flight-plan :global(.flight-plan-halo) {
    fill: none;
    stroke: var(--color-bg);
    stroke-width: 6.5;
    stroke-linecap: round;
    stroke-dasharray: 0 9;
  }

  .flight-plan :global(.flight-plan-line) {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0 9;
  }

  .flight-plan :global(.flight-plan-plane) {
    fill: var(--color-accent);
  }

  .flight-plan :global(.flight-plan-dot) {
    fill: var(--color-accent);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.4);
    transition:
      opacity var(--duration-ui) var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .flight-plan :global(.flight-plan-dot.is-visible) {
    opacity: 1;
    transform: scale(1);
  }
</style>
