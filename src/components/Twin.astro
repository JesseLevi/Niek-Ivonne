---
// Plat figuurtje voor de tweeling (scène 3). Twee keer exact hetzelfde, dat is de grap.
interface Props {
  side: 'left' | 'right';
  label: string;
}

const { side, label } = Astro.props;
---

<button class="twin" type="button" data-twin={side} aria-label={label}>
  <svg viewBox="0 0 40 90" aria-hidden="true">
    <circle cx="20" cy="12" r="9"></circle>
    <path d="M8 34c0-7 5-11 12-11s12 4 12 11v22c0 2-1.5 3.5-3.5 3.5H29V86h-6.5V62h-5v24H11V59.5h-.5C9.5 59.5 8 58 8 56Z"></path>
  </svg>
</button>

<style>
  .twin {
    display: block;
    width: 2.6rem;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--color-accent);
    cursor: pointer;
    transform-origin: 50% 100%;
  }

  svg {
    width: 100%;
    fill: currentColor;
  }
</style>
