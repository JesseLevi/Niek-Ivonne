---
import Illustration from './Illustration.astro';
import { stats, statTokens } from '../lib/content';
import type { Locale } from '../lib/i18n';
import type { Scene } from '../lib/schema';

interface Props {
  scene: Scene;
  lang: Locale;
  /** Plaats van de vorige scène met een vertrekbord; het bord klappert daarvandaan. */
  previousPlace?: string;
  /** Module in src/scenes/ (standaard de algemene verhaalscène). */
  module?: string;
  pin?: number;
}

const { scene, lang, previousPlace, module = 'story', pin } = Astro.props;
const formatted = statTokens(lang);
type StatKey = keyof typeof stats;
const isStat = (key: string): key is StatKey => key in stats;

/** Tekst in stukken: gewone tekst en `{tokens}`, die als teller worden getoond. */
type Segment = { stat: StatKey } | { text: string };
function segments(text: string): Segment[] {
  return text.split(/\{(\w+)\}/).map((part, i) => (i % 2 === 1 && isStat(part) ? { stat: part } : { text: part }));
}
---

<section class="scene" data-scene={scene.id} data-module={module} data-pin={pin} aria-labelledby={`scene-${scene.id}`}>
  <div class="frame">
    <div class="meta">
      <p class="label text-mono" data-scene-label>{scene.label}</p>
      {
        scene.place && (
          <p class="place" data-place data-from={previousPlace ?? ''}>
            {scene.place}
          </p>
        )
      }
    </div>
    {scene.image && <Illustration id={scene.image} lang={lang} class="image" />}
    <div class="lines" id={`scene-${scene.id}`}>
      {
        scene.lines.map((line) => (
          <p class:list={['line', `text-${line.style}`]} data-line data-style={line.style} data-pause={line.pause ? '' : undefined}>
            {segments(line[lang]).map((part) =>
              'stat' in part ? (
                <span
                  data-counter={part.stat}
                  data-to={stats[part.stat].value}
                  data-plus={stats[part.stat].plus ? '' : undefined}
                  data-steps={part.stat === 'messages' ? stats.messages.steps.join(',') : undefined}
                >
                  {formatted[part.stat]}
                </span>
              ) : (
                part.text
              ),
            )}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
  }

  .frame {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    justify-items: center;
    gap: var(--space-5);
    height: var(--screen);
    padding: calc(var(--space-8) + env(safe-area-inset-top)) var(--gutter) calc(var(--space-7) + env(safe-area-inset-bottom));
    text-align: center;
  }

  .meta {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }

  .label,
  .place {
    margin: 0;
  }

  .label {
    color: var(--color-muted);
  }

  .place {
    font-size: var(--text-sm);
  }

  .frame :global(.image) {
    width: auto;
    height: 100%;
    max-height: 42svh;
    object-fit: contain;
    align-self: center;
  }

  .lines {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  .line {
    margin: 0;
  }

  .line.text-mono {
    color: var(--color-accent);
  }
</style>
