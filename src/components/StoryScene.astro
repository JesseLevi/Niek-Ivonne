---
import Illustration from './Illustration.astro';
import { statTokens } from '../lib/content';
import { fill, type Locale } from '../lib/i18n';
import type { Scene } from '../lib/schema';

interface Props {
  scene: Scene;
  lang: Locale;
  /** Module in src/scenes/ (standaard de algemene verhaalscène). */
  module?: string;
  pin?: number;
}

const { scene, lang, module = 'story', pin } = Astro.props;
const tokens = statTokens(lang);
---

<section class="scene" data-scene={scene.id} data-module={module} data-pin={pin} aria-labelledby={`scene-${scene.id}`}>
  <div class="frame">
    <p class="label text-mono" data-scene-label>{scene.label}</p>
    {scene.image && <Illustration id={scene.image} lang={lang} class="image" />}
    <div class="lines" id={`scene-${scene.id}`}>
      {
        scene.lines.map((line) => (
          <p class:list={['line', `text-${line.style}`]} data-line data-pause={line.pause ? '' : undefined}>
            {fill(line[lang], tokens)}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
  }

  .frame {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    justify-items: center;
    gap: var(--space-5);
    height: var(--screen);
    padding: calc(var(--space-8) + env(safe-area-inset-top)) var(--gutter) calc(var(--space-7) + env(safe-area-inset-bottom));
    text-align: center;
  }

  .label {
    margin: 0;
    color: var(--color-muted);
  }

  .frame :global(.image) {
    width: auto;
    height: 100%;
    max-height: 46svh;
    object-fit: contain;
    align-self: center;
  }

  .lines {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  .line {
    margin: 0;
  }

  .line.text-mono {
    color: var(--color-accent);
  }
</style>
